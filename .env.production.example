# ===========================================
# Libya Marketplace — Production Environment
# ===========================================
# Copy this to .env on your production server.
# NEVER commit the real .env to git.

APP_NAME="Libya Marketplace"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Tripoli
APP_URL=https://yourdomain.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# === Database (PostgreSQL) ===
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=libya_marketplace
DB_USERNAME=libya_app
DB_PASSWORD=

# === Session & Cache ===
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

CACHE_STORE=database

# === Queue ===
# Production: use 'database' + supervisor. Do NOT use 'sync' in production.
QUEUE_CONNECTION=database

# === Mail ===
# Replace with a real SMTP provider (Mailgun, Postmark, SendGrid, or your host)
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# === Storage ===
FILESYSTEM_DISK=public

# === Logging ===
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# === Security ===
BCRYPT_ROUNDS=12

# === Broadcasting (unused for now) ===
BROADCAST_CONNECTION=log

# === Vite ===
VITE_APP_NAME="${APP_NAME}"